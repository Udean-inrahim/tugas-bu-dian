# ============ Vercel (serverless) — environment vars ============
# Isi di dashboard Vercel: Settings -> Environment Variables. JANGAN commit .env ke GitHub.

# PostgreSQL serverless (Neon) — pakai pooled connection string dari dashboard Neon
# (host biasanya berakhiran -pooler.neon.tech). WAJIB URL Neon, bukan localhost.
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-something-pooler.aws-us-east-1.neon.tech/neondb?sslmode=require

# Prisma: directUrl opsional untuk migrasi (biasanya non-pooled / prisma:// URL Neon)
DIRECT_URL=

# JWT — wajib ganti, jangan pakai default di produksi! (contoh: openssl rand -hex 32)
JWT_SECRET=replace-with-long-random-string

# CORS — URL frontend di Vercel
CORS_ORIGIN=https://tugas-bu-dian.vercel.app

# Deteksi sensor offline: sensor dianggap OFFLINE setelah tidak ada data selama ini (ms).
# GitHub Actions cron men-tick tiap 60 detik, jadi pakai 120000 (2 menit).
SENSOR_OFFLINE_TIMEOUT=120000

# Token layanan untuk POST /api/system/tick (dipanggil GitHub Actions).
# HARUS sama dengan secret SERVICE_TOKEN di GitHub Actions.
SERVICE_TOKEN=replace-with-a-separate-long-random-string

# MQTT — HANYA untuk backend fastify lokal (tidak dipakai di Vercel serverless)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulator (fastify lokal)
SIMULATE_SENSOR=true
SIM_INTERVAL_MS=5000

# ============ Frontend (Vercel) ============
# Tidak perlu VITE_API_URL / VITE_WS_URL: aplikasi memakai path relatif /api
# pada origin yang sama. Pastikan variabel lama seperti VITE_API_URL/VITE_WS_URL
# DIHAPUS dari dashboard Vercel agar tidak menimpa default.

# ============ GitHub Actions (repo secrets) ============
# Settings -> Secrets and variables -> Actions
# API_URL       = https://tugas-bu-dian.vercel.app
# SERVICE_TOKEN = sama dengan SERVICE_TOKEN di Vercel