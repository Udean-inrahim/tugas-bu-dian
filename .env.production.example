# ============ Backend (Render / Fly.io / VPS) — environment vars ============
# Isi di dashboard penyedia hosting, JANGAN commit file .env ke GitHub.

# PostgreSQL serverless (Neon/Supabase) — pakai URL dari dashboard provider
DATABASE_URL=postgresql://neondb_owner:xxxx@ep-something.aws-us-east-1.neon.tech/neondb?sslmode=require

# MQTT broker cloud gratis (HiveMQ Cloud / EMQX Serverless)
# HiveMQ free: gunakan mqtts:// (TLS port 8883) + MQTT_USERNAME/PASSWORD dari cluster
MQTT_URL=mqtts://broker.hivemq.cloud:8883
MQTT_USERNAME=stm-device
MQTT_PASSWORD=generate-strong-password

# JWT — wajib ganti, jangan pakai default di produksi! (contoh: openssl rand -hex 32)
JWT_SECRET=replace-with-long-random-string

# CORS — URL frontend di Vercel
CORS_ORIGIN=https://tugas-bu-dian.vercel.app

# Simulator: true = data demo tetap mengalir tanpa ESP32
SIMULATE_SENSOR=true
SIM_INTERVAL_MS=5000

# ============ Frontend (Vercel / Netlify) — build-time env ============
# Set di dashboard sebagai variabel build (bukan runtime)
VITE_API_URL=https://stm-backend.onrender.com/api
VITE_WS_URL=wss://stm-backend.onrender.com/ws