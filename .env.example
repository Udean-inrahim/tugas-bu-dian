# ============ Database ============
DATABASE_URL=postgresql://stm:stm_password@localhost:5432/smart_temperature?schema=public

# ============ Backend ============
PORT=8080
HOST=0.0.0.0

# CORS origin for the frontend
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1d

# ============ MQTT ============
MQTT_URL=mqtt://localhost:1883
MQTT_DATA_TOPIC=sensors/+/data
MQTT_HEARTBEAT_TOPIC=sensors/+/heartbeat

# Sensor offline detection (ms)
SENSOR_OFFLINE_TIMEOUT=30000

# ============ Sensor Simulator (dev) ============
# Set SIMULATE_SENSOR=true to generate mock readings without hardware
SIMULATE_SENSOR=true
SIM_SENSOR_CODE=ST-001
SIM_INTERVAL_MS=5000
SIM_TEMP_BASE=28.5
SIM_HUMIDITY_BASE=65

# ============ Email (opsional) ============
# Prioritas: SMTP -> Brevo -> Resend -> (tanpa env) mode demo (kode tampil di layar).
# SMTP Gmail (butuh App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=kamu@gmail.com
# SMTP_PASS=app-password-16-karakter
# EMAIL_FROM=Smart Temp Monitor <kamu@gmail.com>
# Brevo:
# BREVO_API_KEY=xkeysib-xxxxxxxx
# EMAIL_FROM=Smart Temp Monitor <email-verifikasi@gmail.com>
# Resend:
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Smart Temp Monitor <noreply@domainmu.com>
